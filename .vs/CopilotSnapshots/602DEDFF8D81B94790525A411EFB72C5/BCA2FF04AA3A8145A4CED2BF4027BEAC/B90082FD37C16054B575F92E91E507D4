using Sistema.Clases;
using Sistema.Clases.ClasesCitas;
using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace Sistema.Formularios.FormPacientes
{
    /// <summary>
    /// Vista de Citas - Solo interfaz de usuario
    /// NO contiene lógica de negocio
    /// Delega todo al controlador Citas.cs
    /// Sigue patrón MVC: Esta clase solo maneja UI
    /// </summary>
    public partial class CitasForm : Form
    {
        // Controlador de Citas
        Citas controladorCitas = new Citas();
        AlertasDelSistema Alertas = new AlertasDelSistema();

        public CitasForm()
        {
            InitializeComponent();
            CargarDatos();
        }

        /// <summary>
        /// Carga los datos iniciales del formulario (dentistas, estados, etc.)
        /// </summary>
        private void CargarDatos()
        {
            try
            {
                // Cargar dentistas en el combobox
                DataTable dtDentistas = controladorCitas.ObtenerDentistas();
                if (dtDentistas != null && dtDentistas.Rows.Count > 0)
                {
                    cmbDentista.DataSource = dtDentistas;
                    cmbDentista.DisplayMember = "Nombre";
                    cmbDentista.ValueMember = "Id_Dentista";
                }

                // Cargar estados de cita
                cmbEstado.Items.AddRange(new object[] { "Pendiente", "Confirmada", "Completada", "Cancelada" });
                cmbEstado.SelectedIndex = 0;

                // Mostrar citas existentes
                ActualizarGridCitas();
            }
            catch (Exception ex)
            {
                Alertas.Advertencia($"Error al cargar datos: {ex.Message}");
            }
        }

        /// <summary>
        /// Evento del botón Guardar
        /// Llama al controlador para guardar paciente y cita
        /// </summary>
        private void btnGuardar_Click(object sender, EventArgs e)
        {
            // RECOPILAR DATOS DEL FORMULARIO
            string cedula = txtCedula.Text.Trim();
            string nombre = txtNombre.Text.Trim();
            string apellido = txtApellido.Text.Trim();
            string genero = cmbGenero.SelectedItem?.ToString() ?? "";
            string email = txtEmail.Text.Trim();
            string telefono = txtTelefono.Text.Trim();
            string direccion = txtDireccion.Text.Trim();
            DateTime fechaNacimiento = dtpFechaNacimiento.Value;

            int idDentista = cmbDentista.SelectedValue != null ? Convert.ToInt32(cmbDentista.SelectedValue) : 0;
            DateTime fechaCita = dtpFechaCita.Value;
            DateTime horaCita = dtpHoraCita.Value;
            string estado = cmbEstado.SelectedItem?.ToString() ?? "";
            string notas = txtNotas.Text.Trim();

            // LLAMAR AL CONTROLADOR PARA GUARDAR TODO
            int idCita = controladorCitas.GuardarPacienteYCita(
                cedula, nombre, apellido, genero,
                email, telefono, direccion, fechaNacimiento,
                idDentista, fechaCita, horaCita, estado, notas
            );

            // SI GUARDÓ EXITOSAMENTE
            if (idCita > 0)
            {
                LimpiarFormulario();
                ActualizarGridCitas();
            }
        }

        /// <summary>
        /// Evento del botón Cancelar
        /// Limpia el formulario
        /// </summary>
        private void btnCancelar_Click(object sender, EventArgs e)
        {
            LimpiarFormulario();
        }

        /// <summary>
        /// Limpia todos los campos del formulario
        /// </summary>
        private void LimpiarFormulario()
        {
            txtCedula.Text = string.Empty;
            txtNombre.Text = string.Empty;
            txtApellido.Text = string.Empty;
            txtEmail.Text = string.Empty;
            txtTelefono.Text = string.Empty;
            txtDireccion.Text = string.Empty;
            txtNotas.Text = string.Empty;
            cmbGenero.SelectedIndex = -1;
            cmbDentista.SelectedIndex = 0;
            cmbEstado.SelectedIndex = 0;
            dtpFechaCita.Value = DateTime.Now;
            dtpHoraCita.Value = DateTime.Now;
        }

        /// <summary>
        /// Actualiza el DataGridView con las citas existentes
        /// Llama al controlador para obtener los datos
        /// </summary>
        private void ActualizarGridCitas()
        {
            try
            {
                DataTable dt = controladorCitas.MostrarCitas();

                if (dt != null && dt.Rows.Count > 0)
                {
                    dgvCitas.DataSource = dt;
                    dgvCitas.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill;
                    dgvCitas.Refresh();
                }
                else
                {
                    dgvCitas.DataSource = null;
                }
            }
            catch (Exception ex)
            {
                Alertas.Advertencia($"Error al actualizar citas: {ex.Message}");
            }
        }

        /// <summary>
        /// Evento cuando se hace doble clic en una fila del grid
        /// Carga los datos de la cita para editarla
        /// </summary>
        private void dgvCitas_CellDoubleClick(object sender, DataGridViewCellEventArgs e)
        {
            try
            {
                if (e.RowIndex >= 0)
                {
                    DataGridViewRow fila = dgvCitas.Rows[e.RowIndex];
                    
                    // Cargar datos en el formulario para edición
                    txtNombre.Text = fila.Cells["Paciente"].Value?.ToString() ?? "";
                    txtApellido.Text = fila.Cells["Apellido"].Value?.ToString() ?? "";
                    // Nota: Los demás campos se cargarían según la necesidad
                }
            }
            catch (Exception ex)
            {
                Alertas.Advertencia($"Error al cargar cita: {ex.Message}");
            }
        }

        private void btnCerrar_Click(object sender, EventArgs e)
        {
            this.Close();
        }

        private void Minimizar_Click(object sender, EventArgs e)
        {
            this.WindowState = FormWindowState.Minimized;
        }
    }
}
